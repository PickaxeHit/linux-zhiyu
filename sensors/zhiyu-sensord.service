[Unit]
Description=SensorProxy daemon backed by sensh/SNS Client
# Wants, not Requires: the image does not always ship hexagonrpcd, and a
# missing unit must not make this one impossible to enable or start.
After=hexagonrpcd-sensor.service
Wants=hexagonrpcd-sensor.service
Before=iio-sensor-proxy.service

[Service]
Type=simple
ExecStart=/usr/local/bin/zhiyu-sensord
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
