[Unit]
Description=SensorProxy daemon backed by sensh/SNS Client
# The ADSP sensor PD comes from hexagonrpc; keep the dependency soft so a
# missing daemon cannot make this unit impossible to start.
After=hexagonrpcd-adsp-sensorspd.service
Wants=hexagonrpcd-adsp-sensorspd.service
Before=iio-sensor-proxy.service upower.service display-manager.service

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=30
# The fastrpc driver only autoloads on machine-specific udev events; loading
# it here guarantees /dev/fastrpc-adsp exists before sensh talks to the ADSP.
ExecStartPre=-/usr/bin/modprobe -q fastrpc
ExecStartPre=-/usr/bin/modprobe -q uinput
ExecStart=/usr/local/bin/zhiyu-sensord
# UPower retains an open evdev fd across device removal; refresh it on hot restart.
ExecStartPost=-/usr/bin/systemctl try-restart --no-block upower.service
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
