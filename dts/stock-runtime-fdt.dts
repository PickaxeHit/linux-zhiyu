/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Sun QRD SKU2 V8 Power Grid";
	compatible = "qcom,sun-qrd", "qcom,sun", "qcom,sunp-qrd", "qcom,sunp", "qcom,qrd";
	qcom,msm-id = <0x100026a 0x20000 0x27f 0x10000 0x26a 0x10000 0x27f 0x20000 0x26a 0x20000 0x100027f 0x10000 0x100026a 0x10000 0x100027f 0x20000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x2000b 0x00>;

	ddr-regions {
		region2 = <0x09 0x80000000 0x01 0x80000000 0x00 0x00 0x00 0x08 0x00 0x400>;
		region1 = <0x08 0x80000000 0x01 0x00 0x00 0x00 0x00 0x02 0x00 0x400>;
		region0 = <0x00 0x80000000 0x00 0x80000000 0x00 0x00 0x00 0x00 0x00 0x400>;
	};

	memory {
		ddr_device_type = <0x08>;
		device_type = "memory";
		reg = <0x00 0x81960000 0x00 0xa0000 0x00 0x81a40000 0x00 0x1c0000 0x00 0x81cf4000 0x00 0xc000 0x00 0x82460000 0x00 0x40000 0x00 0xd8600000 0x00 0x00 0x00 0xe3720000 0x00 0x1c0e0000 0x08 0x80000000 0x00 0x2f8fe000 0x08 0xb0000000 0x00 0x7500000 0x09 0x80000000 0x01 0x80000000 0x08 0xc0000000 0x00 0xc0000000 0x00 0x82800000 0x00 0x2200000 0x00 0x89d80000 0x00 0x1c80000 0x00 0x8ba01000 0x00 0xf5ff000 0x00 0xa2880000 0x00 0x15780000 0x00 0xb81c0000 0x00 0x1cc63000 0x00 0xd5100000 0x00 0x2f00000>;
	};

	aliases: aliases {
		swr4 = "/soc/spf_core_platform/lpass_bt_swr@6CA0000/bt_swr_mstr";
		swr3 = "/soc/spf_core_platform/lpass-cdc/wsa2-macro@6AA0000/wsa2_swr_master";
		swr2 = "/soc/spf_core_platform/lpass-cdc/va-macro@7660000/va_swr_master";
		swr1 = "/soc/spf_core_platform/lpass-cdc/rx-macro@6AC0000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/lpass-cdc/wsa-macro@6B00000/wsa_swr_master";
		serial0 = "/soc/qcom,qupv3_1_geni_se@ac0000/qcom,qup_uart@a9c000";
		hsuart0 = "/soc/qcom,qupv3_2_geni_se@8c0000/qcom,qup_uart@898000";
		hsuart1 = "/soc/qcom,qupv3_1_geni_se@ac0000/qcom,qup_uart@a88000";
		ufshc1 = "/soc/ufshc@1d84000";
		mmc1 = "/soc/sdhci@8804000";
		phandle = <0x35d>;
	};

	chosen: chosen {
		linux,initrd-end = <0x00 0xb7fff2ec>;
		linux,initrd-start = <0x00 0xb712f000>;
		kaslr-seed = <0x00 0x00>;
		bootargs = "log_buf_len=512K loglevel=6 cpufreq.default_governor=performance sysctl.kernel.sched_pelt_multiplier=4 no-steal-acc kpti=0 swiotlb=0 loop.max_part=7 irqaffinity=0-1 pcie_ports=compat printk.console_no_auto_verbose=0 kasan=off rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kernel.panic_on_rcu_stall=1 disable_dma32=on cgroup_disable=pressure fw_devlink.strict=1 can.stats_timer=0 pci-msm-drv.pcie_sm_regs=0x1D07000,0x1040,0x1048,0x3000,0x1 ftrace_dump_on_oops slub_debug=- video=vfb:640x400,bpp=32,memsize=3072000 nosoftlockup console=ttynull qcom_geni_serial.con_enabled=0 bootconfig  msm_drm.dsi_display0=qcom,mdss_dsi_zhiyu_nt36526_csot_dsc_vid: hqsysfs.pcba_stage=PVT ufsffu.boot_mode=normal rootwait ro init=/init silent_boot.mode=nonsilent";
		stdout-path = "serial0:115200n8";
		phandle = <0x35e>;
	};

	firmware: firmware {
		phandle = <0x35f>;

		qcom_scm: qcom_scm {
			compatible = "qcom,scm-v1.1", "qcom,scm";
			qcom,dload-mode = <0x02 0x19000>;
			phandle = <0xff>;
			qcom,max-queues = <0x02>;
			interrupts = <0x00 0x3c2 0x01>;
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		qcom_mem_object {
			compatible = "qcom,mem-object";
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x04>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			next-level-cache = <0x05>;
			clocks = <0x06 0x00>;
			phandle = <0x10>;

			L2_0: l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x05>;
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x03>;
			power-domains = <0x07>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			next-level-cache = <0x05>;
