			clocks = <0x34 0xa2 0x34 0xa5 0x34 0xa6 0x4f 0x35 0x1b 0x5a 0x03 0x34 0xa4>;
			clock-names = "aux_clk", "pipe_clk", "pipe_clk_mux", "pipe_clk_ext_src", "ref_clk_src", "ref_clk", "com_aux_clk";
			resets = <0x34 0x19 0x34 0x1b>;
			reset-names = "global_phy_reset", "phy_reset";
			pinctrl-names = "unused";
