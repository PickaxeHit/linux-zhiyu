		usb0: ssusb@a600000 {
			compatible = "qcom,dwc-usb3-msm";
			reg = <0xa600000 0x100000 0x1fc6000 0x04>;
			reg-names = "core_base", "tcsr_dyn_en_dis";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			USB3_GDSC-supply = <0x62>;
			clocks = <0x34 0x9c 0x34 0x0b 0x34 0x03 0x34 0x9e 0x34 0xa1>;
			clock-names = "core_clk", "iface_clk", "bus_aggr_clk", "utmi_clk", "sleep_clk";
			resets = <0x34 0x18>;
			reset-names = "core_reset";
			extcon = <0x34a>;
			interrupts-extended = <0x01 0x00 0x82 0x04 0x25 0x0e 0x01 0x25 0x0f 0x01 0x25 0x11 0x04>;
			interrupt-names = "pwr_event_irq", "dp_hs_phy_irq", "dm_hs_phy_irq", "ss_phy_irq";
			qcom,use-pdc-interrupts;
			qcom,use-eusb2-phy;
			qcom,dis-sending-cm-l1-quirk;
			qcom,core-clk-rate = <0xbebc200>;
			qcom,core-clk-rate-hs = <0x3f940ab>;
			qcom,core-clk-rate-disconnected = <0x7f28155>;
			qcom,pm-qos-latency = <0x02>;
			interconnect-names = "usb-ddr", "usb-ipa", "ddr-usb";
			interconnects = <0x7e 0x35 0x44 0x201 0x7e 0x35 0x80 0x20f 0x7f 0x02 0x80 0x221>;
			qcom,num-gsi-evt-buffs = <0x03>;
			qcom,gsi-reg-offset = <0xfc 0x110 0x120 0x130 0x144 0x1a4>;
			dummy-supply = <0x7c>;
			phandle = <0x541>;
			pinctrl-names = "default";
			pinctrl-0 = <0x3df>;
			gpios = <0x26 0x3d 0x00>;
			usb-role-switch;

			dwc3_0: dwc3@a600000 {
				compatible = "snps,dwc3";
				reg = <0x00 0xa600000 0x00 0xd93c>;
				iommus = <0x7c 0x40 0x00>;
				qcom,iommu-dma = "atomic";
				memory-region = <0x34b>;
				dma-coherent;
				interrupts = <0x00 0x85 0x04>;
				usb-phy = <0x34c 0x34d>;
				snps,disable-clk-gating;
				snps,has-lpm-erratum;
				snps,hird-threshold = [00];
				snps,is-utmi-l1-suspend;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				snps,dis_u2_susphy_quirk;
				snps,dis_u3_susphy_quirk;
				snps,ssp-u3-u0-quirk;
				tx-fifo-resize;
				num-hc-interrupters = [00 03];
				dr_mode = "otg";
				maximum-speed = "super-speed-plus";
				usb-role-switch;
				phandle = <0x34e>;
			};

			port {

				endpoint {
					remote-endpoint = <0x698>;
					phandle = <0x699>;
				};
			};
		};

		dwc3_mem_region: dwc3_mem_region {
			iommu-addresses = <0x34e 0x00 0x00 0x00 0x90000000 0x34e 0x00 0xf0000000 0xffffffff 0x10000000>;
			phandle = <0x34b>;
		};

		eusb2_phy0: hsphy@88e3000 {
			compatible = "qcom,usb-m31-eusb2-phy";
			reg = <0x88e3000 0x29c 0x88e2000 0x04 0xc278000 0x04>;
			reg-names = "eusb2_phy_base", "eud_enable_reg", "eud_detect_reg";
			vdd-supply = <0x34f>;
			qcom,vdd-voltage-level = <0x00 0xd6d80 0xd6d80>;
			vdda12-supply = <0x350>;
			vdd_refgen-supply = <0x351>;
			clocks = <0x35 0x1b 0x5a 0x02>;
			clock-names = "ref_clk_src", "ref_clk";
			resets = <0x34 0x13>;
			reset-names = "phy_reset";
			phandle = <0x34c>;
			dummy-supply = <0x697>;
			usb-repeater = <0x697>;
		};

		usb_qmp_dp_phy: ssphy@88e8000 {
			compatible = "qcom,usb-ssphy-qmp-dp-combo";
			reg = <0x88e8000 0x3000>;
			reg-names = "qmp_phy_base";
			vdd-supply = <0x34f>;
			qcom,vdd-voltage-level = <0x00 0xd6d80 0xd6d80>;
			qcom,vdd-max-load-uA = <0xb798>;
			core-supply = <0x350>;
