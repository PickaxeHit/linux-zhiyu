		clock-controller@f204008 {
			compatible = "qcom,sm8750-tcsr", "syscon";
			reg = <0x00 0xf204008 0x00 0x3004>;
			clocks = <0x6e 0x00>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x9c>;
		};

		stm@10002000 {
			compatible = "arm,coresight-stm", "arm,primecell";
			reg = <0x00 0x10002000 0x00 0x1000 0x00 0x37280000 0x00 0x180000>;
			reg-names = "stm-base", "stm-stimulus-base";
			clocks = <0x7a>;
			clock-names = "apb_pclk";

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xcc>;
						phandle = <0xd2>;
					};
				};
			};
		};

		tpda@10004000 {
			compatible = "qcom,coresight-tpda", "arm,primecell";
			reg = <0x00 0x10004000 0x00 0x1000>;
			clocks = <0x7a>;
			clock-names = "apb_pclk";

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0xcd>;
						phandle = <0xcf>;
					};
				};
			};

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xce>;
						phandle = <0xd1>;
					};
				};
			};
		};

		tpdm@1000f000 {
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x1000f000 0x00 0x1000>;
			clocks = <0x7a>;
			clock-names = "apb_pclk";
			qcom,cmb-element-bits = <0x40>;
			qcom,cmb-msrs-num = <0x20>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xcf>;
						phandle = <0xcd>;
					};
				};
			};
		};

		funnel@10041000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x00 0x10041000 0x00 0x1000>;
			clocks = <0x7a>;
			clock-names = "apb_pclk";

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xd0>;
						phandle = <0x100>;
					};
				};

				port@6 {
					reg = <0x06>;

					endpoint {
						remote-endpoint = <0xd1>;
						phandle = <0xce>;
					};
				};

				port@7 {
					reg = <0x07>;

					endpoint {
						remote-endpoint = <0xd2>;
						phandle = <0xcc>;
					};
				};
			};

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xd3>;
						phandle = <0x103>;
					};
				};
			};
		};

		tpdm@10800000 {
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x10800000 0x00 0x1000>;
			clocks = <0x7a>;
			clock-names = "apb_pclk";
			qcom,dsb-element-bits = <0x20>;
			qcom,dsb-msrs-num = <0x20>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0xd4>;
