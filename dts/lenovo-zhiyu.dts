				reg = <0x05 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x05 0x0a 0x00 0x03>;
