	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x00>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x03 0x04 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x0d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x02>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x100>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x05 0x04 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x0e>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x200>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x06 0x04 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x0f>;
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x300>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x07 0x04 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x10>;
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x400>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x08 0x04 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x11>;
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x500>;
			enable-method = "psci";
			next-level-cache = <0x02>;
			power-domains = <0x09 0x04 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x12>;
		};

		cpu@10000 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			next-level-cache = <0x0a>;
			power-domains = <0x0b 0x04 0x01>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x13>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x0a>;
			};
		};

		cpu@10100 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			next-level-cache = <0x0a>;
			power-domains = <0x0c 0x04 0x01>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x14>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};

				core2 {
					cpu = <0x0f>;
				};

				core3 {
					cpu = <0x10>;
				};

				core4 {
					cpu = <0x11>;
				};

				core5 {
					cpu = <0x12>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x13>;
				};

				core1 {
					cpu = <0x14>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0x5d>;
				exit-latency-us = <0x81>;
				min-residency-us = <0x230>;
				phandle = <0x1c>;
			};

			cpu-sleep-1 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0xac>;
				exit-latency-us = <0x82>;
				min-residency-us = <0x2ae>;
				phandle = <0x1e>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000054>;
				entry-latency-us = <0x866>;
				exit-latency-us = <0x7bf>;
				min-residency-us = <0x23b8>;
				phandle = <0x1f>;
			};

			domain-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x200c354>;
				entry-latency-us = <0xaf0>;
				exit-latency-us = <0x1130>;
				min-residency-us = <0x27a6>;
				phandle = <0x21>;
			};
		};
	};

