			interconnects = <0x55 0x05 0x07 0x16 0x01 0x07 0x2b 0x02 0x03 0x2c 0x1b 0x03>;
			interconnect-names = "usb-ddr", "apps-usb";
			iommus = <0x28 0x40 0x00>;
			phys = <0xa3>, <0x27 0x00>;
			phy-names = "usb2-phy", "usb3-phy";
			snps,hird-threshold = [00];
			snps,usb2-gadget-lpm-disable;
