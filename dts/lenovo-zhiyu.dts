				#address-cells = <0x01>;
				#size-cells = <0x00>;

				temp-alarm@a00 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0xa00>;
					interrupts = <0x07 0x0a 0x00 0x03>;
					#thermal-sensor-cells = <0x00>;
					phandle = <0x156>;
				};

				gpio@8800 {
					compatible = "qcom,pmih0108-gpio", "qcom,spmi-gpio";
					reg = <0x8800>;
					gpio-controller;
					gpio-ranges = <0xc4 0x00 0x00 0x12>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0xc4>;
				};

				phy@fd00 {
					compatible = "qcom,pm8550b-eusb2-repeater";
					reg = <0xfd00>;
					#phy-cells = <0x00>;
					qcom,tune-usb2-preem = [03];
					qcom,tune-usb2-amplitude = [0a];
					qcom,squelch-detector-bp = <0xfffff830>;
					vdd18-supply = <0xc5>;
					vdd3-supply = <0xc6>;
					status = "okay";
					phandle = <0x9f>;
				};
			};

			pmic@0 {
				compatible = "qcom,pm8550", "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pon@1300 {
					compatible = "qcom,pmk8350-pon";
					reg = <0x1300 0x800>;
					reg-names = "hlos", "pbs";

					pwrkey {
						compatible = "qcom,pmk8350-pwrkey";
						interrupts = <0x00 0x13 0x07 0x03>;
						linux,code = <0x74>;
						status = "okay";
					};

					resin {
						compatible = "qcom,pmk8350-resin";
						interrupts = <0x00 0x13 0x06 0x03>;
						linux,code = <0x72>;
						status = "okay";
					};
				};

				rtc@6100 {
					compatible = "qcom,pmk8350-rtc";
					reg = <0x6100 0x6200>;
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x62 0x01 0x01>;
					/* the SPMI arbiter gives another execution environment
					 * write access to the RTC registers, so the wall-clock
					 * offset is kept in SDAM instead (mainline scheme).
					 */
					nvmem-cells = <&rtc_offset>;
					nvmem-cell-names = "offset";
				};

				nvram@7100 {
					compatible = "qcom,spmi-sdam";
					reg = <0x7100>;
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					ranges = <0x00 0x7100 0x100>;

					reboot-reason@48 {
						reg = <0x48 0x01>;
						bits = <0x01 0x07>;
						phandle = <0x15e>;
					};

					/* 4-byte little-endian RTC offset (time when the PMIC
					 * counter was last reset), free slot in this SDAM
					 */
					rtc_offset: rtc-offset@60 {
						reg = <0x60 0x04>;
					};
				};

				gpio@b800 {
					compatible = "qcom,pmk8550-gpio", "qcom,spmi-gpio";
					reg = <0xb800>;
					gpio-controller;
					gpio-ranges = <0xc7 0x00 0x00 0x06>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0xc7>;
				};

