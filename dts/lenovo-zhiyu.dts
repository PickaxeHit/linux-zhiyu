/dts-v1/;

#include <dt-bindings/clock/qcom,sm8750-camcc.h>
#include <dt-bindings/clock/qcom,sm8750-cambistmclkcc.h>
#include <dt-bindings/clock/qcom,sm8750-gcc.h>
#include <dt-bindings/interconnect/qcom,sm8750-rpmh.h>
#include <dt-bindings/interconnect/qcom,icc.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Lenovo TB378FC";
	compatible = "lenovo,zhiyu", "qcom,sm8750";
	chassis-type = "tablet";
	xiaomi,mainline-model = "Lenovo TB378FC";
	xiaomi,mainline-compatible = "lenovo,zhiyu", "qcom,sm8750";
	lenovo,mainline-model = "Lenovo TB378FC";
	lenovo,mainline-compatible = "lenovo,zhiyu", "qcom,sm8750";
	qcom,msm-id = <0x100026a 0x20000 0x27f 0x10000 0x26a 0x10000 0x27f 0x20000 0x26a 0x20000 0x100027f 0x10000 0x100026a 0x10000 0x100027f 0x20000>;
	qcom,board-id = <0x00 0x00>;
	sound {
		compatible = "qcom,sm8750-sndcard";
		model = "sm8750";
		pinctrl-names = "default";
		pinctrl-0 = <&main_tdm_active_state>;
		status = "okay";
	};



