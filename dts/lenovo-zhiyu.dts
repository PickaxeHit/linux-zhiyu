	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	tpdm-cdsp-llm {
		compatible = "qcom,coresight-static-tpdm";
		qcom,cmb-element-bits = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x15b>;
					phandle = <0xe5>;
				};
			};
		};
	};

	tpdm-cdsp-llm2 {
		compatible = "qcom,coresight-static-tpdm";
		qcom,cmb-element-bits = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x15c>;
					phandle = <0xe6>;
				};
			};
		};
	};

	tpdm-modem1 {
		compatible = "qcom,coresight-static-tpdm";
		qcom,dsb-element-bits = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x15d>;
					phandle = <0xd6>;
				};
			};
		};
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x15e>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	wcn7860-pmu {
		compatible = "qcom,wcn7860-pmu";
		pinctrl-names = "default";
		pinctrl-0 = <0x15f 0x160 0x161 0x162>;
		wlan-enable-gpios = <0x66 0x10 0x00>;
		bt-enable-gpios = <0xc9 0x03 0x00>;
		swctrl-gpios = <0x66 0x12 0x00>;
		vddio-supply = <0x42>;
		vddio1p2-supply = <0x163>;
		vddaon-supply = <0x164>;
		vdddig-supply = <0x165>;
		vddrfa1p2-supply = <0x166>;
		vddrfa1p8-supply = <0x167>;
		clocks = <0x6e 0x06>;
		status = "okay";

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
				phandle = <0x118>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
				phandle = <0x43>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x119>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
				phandle = <0x11a>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
				phandle = <0x44>;
			};

			ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x45>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x46>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
				phandle = <0x47>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
				regulator-always-on;
				phandle = <0x11b>;
			};

			ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0x11c>;
			};
		};
	};

	aliases {
		serial0 = "/soc@0/geniqup@ac0000/serial@a9c000";
	};

	chosen {
		stdout-path = "serial0:115200n8";

		framebuffer {
			compatible = "simple-framebuffer";
			memory-region = <0x168>;
			clocks = <0x29 0x10>;
			width = <0xdb0>;
			height = <0x88e>;
			stride = <0x36c0>;
			format = "x8r8g8b8";
		};
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x493e000>;
			#clock-cells = <0x00>;
			phandle = <0x12b>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7d00>;
			#clock-cells = <0x00>;
			phandle = <0x25>;
		};

		bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x6e 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x24>;
		};

		bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x6e 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x6f>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x169>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <0xc3 0x06 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x20>;
			linux,can-disable;
			wakeup-source;
		};
	};

	ddr-regions {
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	mem-offline {
		compatible = "qcom,mem-offline";
	};

	regulator-panel-vddio {
		compatible = "regulator-fixed";
		regulator-name = "panel_vddio_1p8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		phandle = <0xb7>;
	};

	regulator-panel-vci {
		compatible = "regulator-fixed";
		regulator-name = "panel_vci_3p0";
		regulator-min-microvolt = <0x2dc6c0>;
		regulator-max-microvolt = <0x2dc6c0>;
		regulator-always-on;
	};

	regulator-panel-vdda {
		compatible = "regulator-fixed";
		regulator-name = "panel_vdda_1p2";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		phandle = <0x9e>;
	};

	regulator-panel-avdd {
		compatible = "regulator-fixed";
		regulator-name = "panel_avdd_6p0";
		regulator-min-microvolt = <0x5b8d80>;
		regulator-max-microvolt = <0x5b8d80>;
		regulator-always-on;
		phandle = <0xb8>;
	};

	regulator-panel-avee {
		compatible = "regulator-fixed";
		regulator-name = "panel_avee_n4p6";
		regulator-min-microvolt = <0x4630c0>;
		regulator-max-microvolt = <0x4630c0>;
		regulator-always-on;
		phandle = <0xb9>;
	};

	regulator-panel-vdds {
		compatible = "regulator-fixed";
		regulator-name = "panel_vdds_0p9";
		regulator-min-microvolt = <0xd6d80>;
		regulator-max-microvolt = <0xd6d80>;
		regulator-always-on;
		phandle = <0xbc>;
	};

	regulator-ufs-vdda-phy {
		compatible = "regulator-fixed";
		regulator-name = "ufs_vdda_phy";
		regulator-min-microvolt = <0xd6d80>;
		regulator-max-microvolt = <0xd6d80>;
		regulator-always-on;
		phandle = <0x120>;
	};

	regulator-ufs-vdda-pll {
		compatible = "regulator-fixed";
		regulator-name = "ufs_vdda_pll";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		phandle = <0x121>;
	};

	regulator-ufs-vdda-qref {
		compatible = "regulator-fixed";
		regulator-name = "ufs_vdda_qref";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		phandle = <0x122>;
	};

	regulator-ufs-vdda-refgen {
		compatible = "regulator-fixed";
		regulator-name = "ufs_vdda_refgen";
		regulator-min-microvolt = <0xd6d80>;
		regulator-max-microvolt = <0xd6d80>;
		regulator-always-on;
		phandle = <0x123>;
	};

	regulator-ufs-vccq-parent {
		compatible = "regulator-fixed";
		regulator-name = "ufs_vccq_parent";
		regulator-min-microvolt = <0x147260>;
		regulator-max-microvolt = <0x147260>;
		regulator-always-on;
		phandle = <0x129>;
	};

	regulator-ufs-vddp-ref-clk {
		compatible = "regulator-fixed";
		regulator-name = "ufs_vddp_ref_clk";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
		phandle = <0x12a>;
	};

	regulator-pcie-vdda-0p9 {
		compatible = "regulator-fixed";
		regulator-name = "pcie_vdda_0p9";
		regulator-min-microvolt = <0xdbba0>;
		regulator-max-microvolt = <0xdbba0>;
		regulator-always-on;
		phandle = <0x116>;
	};

	regulator-pcie-vddpe-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "pcie_vddpe_3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		regulator-always-on;
		phandle = <0x117>;
	};

	regulator-pcie-phy-0p88 {
		compatible = "regulator-fixed";
		regulator-name = "pcie_phy_0p88";
		regulator-min-microvolt = <0xd6d80>;
		regulator-max-microvolt = <0xd6d80>;
		regulator-always-on;
	};

	regulator-pcie-phy-1p2 {
		compatible = "regulator-fixed";
		regulator-name = "pcie_phy_1p2";
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		regulator-always-on;
	};

	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink", "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		/* TLMM gpio61 follows the USB-C plug orientation (low/high). */
		orientation-gpios = <0x66 0x3d 0x00>;

		/* Dual-role USB-C port: the PMIC firmware reports CC state through
		 * pmic-glink; UCSI drives the dwc3 role switch through this graph.
		 */
		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&dwc3_hs_out>;
					};
				};

				port@1 {
					reg = <0x01>;

					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};

				port@2 {
					reg = <0x02>;

					pmic_glink_sbu: endpoint {
						remote-endpoint = <&wcd_usbss_mux>;
					};
				};
			};
		};
	};
};
&{/} {
		camss: isp@ad27000 {
			compatible = "qcom,sm8750-camss";
			iommus = <&apps_smmu 0x1c00 0x0>;
			dma-coherent;
			vdd-csiphy5-1p2-supply = <&cam_csi1p2>;
			vdd-csiphy5-0p9-supply = <&cam_csi0p9>;

			reg = <0x0 0x0ad27000 0x0 0x2b00>,
			      <0x0 0x0ad2a000 0x0 0x2b00>,
			      <0x0 0x0ad2d000 0x0 0x2b00>,
			      <0x0 0x0ad6d000 0x0 0xa00>,
			      <0x0 0x0ad72000 0x0 0xa00>,
			      <0x0 0x0ada9000 0x0 0x2000>,
			      <0x0 0x0adab000 0x0 0x2000>,
			      <0x0 0x0adad000 0x0 0x2000>,
			      <0x0 0x0adaf000 0x0 0x2000>,
			      <0x0 0x0adb1000 0x0 0x2000>,
			      <0x0 0x0adb3000 0x0 0x2000>,
			      <0x0 0x0ad8b000 0x0 0x400>,
			      <0x0 0x0ad8c000 0x0 0x400>,
			      <0x0 0x0ad8d000 0x0 0x400>,
			      <0x0 0x0ac86000 0x0 0x10000>,
			      <0x0 0x0ac96000 0x0 0x10000>,
			      <0x0 0x0aca6000 0x0 0x10000>,
			      <0x0 0x0ad6e000 0x0 0x3000>,
			      <0x0 0x0ad73000 0x0 0x3000>;
			reg-names = "csid0",
				    "csid1",
				    "csid2",
				    "csid_lite0",
				    "csid_lite1",
				    "csiphy0",
				    "csiphy1",
				    "csiphy2",
				    "csiphy3",
				    "csiphy4",
				    "csiphy5",
				    "csitpg0",
				    "csitpg1",
				    "csitpg2",
				    "vfe0",
				    "vfe1",
				    "vfe2",
				    "vfe_lite0",
				    "vfe_lite1";

			clocks = <&camcc CAM_CC_CAMNOC_NRT_AXI_CLK>,
				 <&camcc CAM_CC_CAMNOC_RT_AXI_CLK>,
				 <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
				 <&camcc CAM_CC_CAM_TOP_FAST_AHB_CLK>,
				 <&camcc CAM_CC_CAMNOC_RT_TFE_0_MAIN_CLK>,
				 <&camcc CAM_CC_CAMNOC_RT_TFE_1_MAIN_CLK>,
				 <&camcc CAM_CC_CAMNOC_RT_TFE_2_MAIN_CLK>,
				 <&camcc CAM_CC_CAMNOC_RT_IFE_LITE_CLK>,
				 <&camcc CAM_CC_CSID_CLK>,
				 <&camcc CAM_CC_CSID_CSIPHY_RX_CLK>,
				 <&camcc CAM_CC_CSIPHY0_CLK>,
				 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
				 <&camcc CAM_CC_CSIPHY1_CLK>,
				 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
				 <&camcc CAM_CC_CSIPHY2_CLK>,
				 <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
				 <&camcc CAM_CC_CSIPHY3_CLK>,
				 <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
				 <&camcc CAM_CC_CSIPHY4_CLK>,
				 <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
				 <&camcc CAM_CC_CSIPHY5_CLK>,
				 <&camcc CAM_CC_CSI5PHYTIMER_CLK>,
				 <&gcc GCC_CAMERA_HF_AXI_CLK>,
				 <&gcc GCC_CAMERA_SF_AXI_CLK>,
				 <&camcc CAM_CC_TFE_0_MAIN_CLK>,
				 <&camcc CAM_CC_TFE_0_MAIN_FAST_AHB_CLK>,
				 <&camcc CAM_CC_TFE_1_MAIN_CLK>,
				 <&camcc CAM_CC_TFE_1_MAIN_FAST_AHB_CLK>,
				 <&camcc CAM_CC_TFE_2_MAIN_CLK>,
				 <&camcc CAM_CC_TFE_2_MAIN_FAST_AHB_CLK>,
				 <&camcc CAM_CC_IFE_LITE_CLK>,
				 <&camcc CAM_CC_IFE_LITE_AHB_CLK>,
				 <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>,
				 <&camcc CAM_CC_IFE_LITE_CSID_CLK>,
				 <&camcc CAM_CC_QDSS_DEBUG_XO_CLK>;
			clock-names = "camnoc_nrt_axi",
				      "camnoc_rt_axi",
				      "cpas_ahb",
				      "cpas_fast_ahb",
				      "cpas_vfe0",
				      "cpas_vfe1",
				      "cpas_vfe2",
				      "cpas_vfe_lite",
				      "csid",
				      "csid_csiphy_rx",
				      "csiphy0",
				      "csiphy0_timer",
				      "csiphy1",
				      "csiphy1_timer",
				      "csiphy2",
				      "csiphy2_timer",
				      "csiphy3",
				      "csiphy3_timer",
				      "csiphy4",
				      "csiphy4_timer",
				      "csiphy5",
				      "csiphy5_timer",
				      "gcc_axi_hf",
				      "gcc_axi_sf",
				      "vfe0",
				      "vfe0_fast_ahb",
				      "vfe1",
				      "vfe1_fast_ahb",
				      "vfe2",
				      "vfe2_fast_ahb",
				      "vfe_lite",
				      "vfe_lite_ahb",
				      "vfe_lite_cphy_rx",
				      "vfe_lite_csid",
				      "qdss_debug_xo";

			interrupts = <GIC_SPI 601 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 603 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 431 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 605 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 376 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 433 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 436 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 457 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 606 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 377 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "csid0",
					  "csid1",
					  "csid2",
					  "csid_lite0",
					  "csid_lite1",
					  "csiphy0",
					  "csiphy1",
					  "csiphy2",
					  "csiphy3",
					  "csiphy4",
					  "csiphy5",
					  "vfe0",
					  "vfe1",
					  "vfe2",
					  "vfe_lite0",
					  "vfe_lite1";



			power-domains = <&camcc CAM_CC_TFE_0_GDSC>,
					<&camcc CAM_CC_TFE_1_GDSC>,
					<&camcc CAM_CC_TFE_2_GDSC>,
					<&camcc CAM_CC_TITAN_TOP_GDSC>;
			power-domain-names = "ife0", "ife1", "ife2", "top";

			status = "okay";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
				};

				port@1 {
					reg = <1>;
				};

				port@2 {
					reg = <2>;
				};

				port@3 {
					reg = <3>;
				};

				port@4 {
					reg = <4>;
				};

				port@5 {
					reg = <5>;
					csiphy5_ep: endpoint {
						remote-endpoint = <&ov13b10_ep>;
						data-lanes = <0 1 2 3>;
						link-frequencies = /bits/ 64 <560000000>;
					};
				};
			};

		};
		cci0: cci@ac7b000 {
			compatible = "qcom,sm8750-cci", "qcom,msm8996-cci";
			reg = <0x0 0x0ac7b000 0x0 0x1000>;
			interrupts = <GIC_SPI 426 IRQ_TYPE_EDGE_RISING>;
			power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
			clocks = <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
				 <&camcc CAM_CC_CCI_0_CLK>;
			clock-names = "ahb", "cci";
			pinctrl-0 = <&cam_cci0_default>;
			pinctrl-names = "default";
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			cci0_i2c0: i2c-bus@0 {
				reg = <0>;
				clock-frequency = <400000>;
				#address-cells = <1>;
				#size-cells = <0>;
							ov13b10: camera@36 {
					compatible = "lenovo,tb378fc-ov13b10", "ovti,ov13b10";
					reg = <0x36>;
					reset-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
					clocks = <&cambistmclkcc 6>;
					clock-names = "xvclk";
					pinctrl-names = "default";
					pinctrl-0 = <&cam_mclk3_default &cam_reset11_default>;
					assigned-clocks = <&cambistmclkcc 6>;
					assigned-clock-rates = <19200000>;
					dovdd-supply = <&cam_vio>;
					avdd-supply = <&cam_vana>;
					vaf-supply = <&cam_vaf>;
					dvdd-supply = <&cam_vdig>;
					status = "okay";
					port {
						ov13b10_ep: endpoint {
							remote-endpoint = <&csiphy5_ep>;
							data-lanes = <1 2 3 4>;
							link-frequencies = /bits/ 64 <560000000>;
						};
					};
				};
};
		};

		cci1: cci@ac7c000 {
			compatible = "qcom,sm8750-cci", "qcom,msm8996-cci";
			reg = <0x0 0x0ac7c000 0x0 0x1000>;
			interrupts = <GIC_SPI 427 IRQ_TYPE_EDGE_RISING>;
			power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
			clocks = <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
				 <&camcc CAM_CC_CCI_1_CLK>;
			clock-names = "ahb", "cci";
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			cci1_i2c0: i2c-bus@0 {
				reg = <0>;
				clock-frequency = <400000>;
				#address-cells = <1>;
				#size-cells = <0>;
			

			
};

			cci1_i2c1: i2c-bus@1 {
				reg = <1>;
				clock-frequency = <1000000>;
				#address-cells = <1>;
				#size-cells = <0>;
			
};


		};
};


&tlmm {
	cam_mclk4_default: cam-mclk4-default {
		pins = "gpio93";
		function = "cam_aon_mclk4";
		drive-strength = <2>;
		bias-disable;
	};

	cam_reset4_default: cam-reset4-default {
		pins = "gpio7";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};
	cam_mclk3_default: cam-mclk3-default {
		pins = "gpio92";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	cam_reset11_default: cam-reset11-default {
		pins = "gpio11";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};

	cam_cci0_default: cam-cci0-default {
		scl-pins {
			pins = "gpio114";
			function = "cci_i2c_scl";
			drive-strength = <2>;
			bias-pull-up;
		};
		sda-pins {
			pins = "gpio113";
			function = "cci_i2c_sda";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

};

