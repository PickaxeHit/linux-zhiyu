		scm {
			compatible = "qcom,scm-sm8750", "qcom,scm";
			interconnects = <0x15 0x02 0x07 0x16 0x01 0x07>;
		};

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x17 0x00 0x17 0x02>;
			mbox-names = "tx", "rx";
			shmem = <0x18 0x19>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x04>;
			};
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8750-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1a>;
		phandle = <0x2a>;
	};

	interconnect-1 {
		compatible = "qcom,sm8750-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1a>;
		phandle = <0x16>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x03>;
		};

		power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x05>;
		};

		power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x06>;
		};

		power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x07>;
		};

		power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x08>;
		};

		power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1b>;
			domain-idle-states = <0x1c>;
			phandle = <0x09>;
		};

		power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0b>;
		};

		power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1d>;
			domain-idle-states = <0x1e>;
			phandle = <0x0c>;
		};

		power-domain-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x1f>;
			power-domains = <0x20>;
			phandle = <0x1b>;
		};

		power-domain-cluster1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x1f>;
			power-domains = <0x20>;
			phandle = <0x1d>;
		};

