		pinctrl@7760000 {
			compatible = "qcom,sm8750-lpass-lpi-pinctrl", "qcom,sm8650-lpass-lpi-pinctrl";
			reg = <0x00 0x7760000 0x00 0x20000>;
			clocks = <0x89 0x66 0x01 0x89 0x67 0x01>;
			clock-names = "core", "audio";
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x93 0x00 0x00 0x17>;
			status = "okay";
			phandle = <0x93>;


			tx-swr-active-state {
				phandle = <0x92>;

				clk-pins {
					pins = "gpio0";
					function = "swr_tx_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio1", "gpio2", "gpio14";
					function = "swr_tx_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			rx-swr-active-state {
				phandle = <0x8e>;

				clk-pins {
					pins = "gpio3";
					function = "swr_rx_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio4", "gpio5";
					function = "swr_rx_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			dmic01-default-state {

				clk-pins {
					pins = "gpio6";
					function = "dmic1_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio7";
					function = "dmic1_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			dmic23-default-state {

				clk-pins {
					pins = "gpio8";
					function = "dmic2_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio9";
					function = "dmic2_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			wsa-swr-active-state {
				phandle = <0x90>;

				clk-pins {
					pins = "gpio10";
					function = "wsa_swr_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio11";
					function = "wsa_swr_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			wsa2-swr-active-state {
				phandle = <0x8c>;

				clk-pins {
					pins = "gpio15";
					function = "wsa2_swr_clk";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-disable;
				};

				data-pins {
					pins = "gpio16";
					function = "wsa2_swr_data";
					drive-strength = <0x02>;
					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};
		};

