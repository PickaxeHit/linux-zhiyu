			frame@16809000 {
				reg = <0x00 0x16809000 0x1000>;
				interrupts = <0x00 0x0c 0x04>;
				frame-number = <0x04>;
				status = "disabled";
			};

			frame@1680b000 {
				reg = <0x00 0x1680b000 0x1000>;
				interrupts = <0x00 0x0d 0x04>;
				frame-number = <0x05>;
				status = "disabled";
			};

			frame@1680d000 {
				reg = <0x00 0x1680d000 0x1000>;
