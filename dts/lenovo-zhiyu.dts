				clocks = <0x29 0x60>;
				clock-names = "se";
				interconnects = <0x2a 0x01 0x07 0x2a 0x04 0x07 0x2b 0x02 0x07 0x2c 0x13 0x07 0x55 0x01 0x07 0x16 0x01 0x07>;
				interconnect-names = "qup-core", "qup-config", "qup-memory";
				dmas = <0x56 0x00 0x04 0x01 0x56 0x01 0x04 0x01>;
				dma-names = "tx", "rx";
				pinctrl-0 = <0x64 0x65>;
				pinctrl-names = "default";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				touchscreen@0 {
					compatible = "novatek,nt36526e";
					reg = <0x00>;
					spi-max-frequency = <0x927c00>;
					interrupt-parent = <0x66>;
					/* stock nvt_36xxx.ko hard-codes IRQF_TRIGGER_RISING
					 * (flags field = 1 | IRQF_ONESHOT), ignoring DT. */
					interrupts = <0xa2 0x01>;
					firmware-name = "novatek/nt36526e-zhiyu.bin";
					panel = <&panel>;
				};
			};

			i2c@a94000 {
				compatible = "qcom,geni-i2c";
				reg = <0x00 0xa94000 0x00 0x4000>;
				interrupts = <0x00 0x166 0x04>;
				clocks = <0x29 0x62>;
				clock-names = "se";
				interconnects = <0x2a 0x01 0x07 0x2a 0x04 0x07 0x2b 0x02 0x07 0x2c 0x13 0x07 0x55 0x01 0x07 0x16 0x01 0x07>;
				interconnect-names = "qup-core", "qup-config", "qup-memory";
				dmas = <0x56 0x00 0x05 0x03 0x56 0x01 0x05 0x03>;
				dma-names = "tx", "rx";
				pinctrl-0 = <0x67>;
				pinctrl-names = "default";
				#address-cells = <0x01>;
