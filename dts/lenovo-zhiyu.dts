			resets = <0x29 0x19 0x29 0x17>;
			reset-names = "phy", "common";
			power-domains = <0x29 0x05>;
			/* vreg_l3g_1p2 (1.2 V) and vreg_l2d_0p88 (0.88 V), as on stock */
