		timer@16800000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0x00 0x16800000 0x00 0x1000>;
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x00 0x00 0x20000000>;

			frame@16801000 {
				reg = <0x00 0x16801000 0x1000 0x00 0x16802000 0x1000>;
				interrupts = <0x00 0x08 0x04 0x00 0x06 0x04>;
				frame-number = <0x00>;
			};

			frame@16803000 {
				reg = <0x00 0x16803000 0x1000>;
				interrupts = <0x00 0x09 0x04>;
				frame-number = <0x01>;
				status = "disabled";
			};

			frame@16805000 {
				reg = <0x00 0x16805000 0x1000>;
				interrupts = <0x00 0x0a 0x04>;
				frame-number = <0x02>;
				status = "disabled";
