			i2c@a8c000 {
				compatible = "qcom,geni-i2c";
				reg = <0x00 0xa8c000 0x00 0x4000>;
				interrupts = <0x00 0x164 0x04>;
				clocks = <0x29 0x5e>;
				clock-names = "se";
				interconnects = <0x2a 0x01 0x07 0x2a 0x04 0x07 0x2b 0x02 0x07 0x2c 0x13 0x07 0x55 0x01 0x07 0x16 0x01 0x07>;
				interconnect-names = "qup-core", "qup-config", "qup-memory";
				dmas = <0x56 0x00 0x03 0x03 0x56 0x01 0x03 0x03>;
				dma-names = "tx", "rx";
				pinctrl-0 = <0x60>;
				pinctrl-names = "default";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				/* SS lane switch and orientation, inside the WCD9390 */
				typec-mux@e {
					compatible = "qcom,wcd9390-usbss";
					reg = <0x0e>;
					vdd-supply = <0xc5>;
					mode-switch;
					orientation-switch;

					ports {
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						port@0 {
							reg = <0x00>;

							wcd_usbss_mux: endpoint {
								remote-endpoint = <&pmic_glink_sbu>;
							};
						};
					};
				};
			};

			spi@a8c000 {
				compatible = "qcom,geni-spi";
				reg = <0x00 0xa8c000 0x00 0x4000>;
				interrupts = <0x00 0x164 0x04>;
				clocks = <0x29 0x5e>;
				clock-names = "se";
				interconnects = <0x2a 0x01 0x07 0x2a 0x04 0x07 0x2b 0x02 0x07 0x2c 0x13 0x07 0x55 0x01 0x07 0x16 0x01 0x07>;
