					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0xc3>;

					volume-up-n-state {
						pins = "gpio6";
						function = "normal";
						power-source = <0x01>;
						bias-pull-up;
						input-enable;
						phandle = <0x169>;
					};
				};

				led-controller@ee00 {
					compatible = "qcom,pm8550-flash-led", "qcom,spmi-flash-led";
