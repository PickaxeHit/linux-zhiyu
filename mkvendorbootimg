#!/bin/bash
# mkvendorbootimg — build and AVB-sign vendor_boot.img for Lenovo TB378FC
# ("zhiyu", SM8750).
#
#   vendor_boot.img = vendor ramdisk (our initramfs: /init + lib/modules/*.ko)
#                   + board DTB (dts/lenovo-zhiyu.dtb)
#                   + vendor_bootconfig (extra command line, see bootconfig below)
#
# usage: ./mkvendorbootimg [outdir]
# env:   RAMDISK (prebuilt .cpio.gz), INITRAMFS (staging dir), DTB, BOOTCONFIG,
#        KEY, SIZE, OUT
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
OUT=${OUT:-${1:-$ROOT/out}}
INITRAMFS=${INITRAMFS:-$ROOT/initramfs}
RAMDISK=${RAMDISK:-}
DTB=${DTB:-$ROOT/dts/lenovo-zhiyu.dtb}
DTS=${DTS:-$ROOT/dts/lenovo-zhiyu.dts}
BOOTCONFIG=${BOOTCONFIG:-$ROOT/bootconfig.extra}
KEY=${KEY:-$ROOT/avb-test-key.pem}
SIZE=${SIZE:-100663296}		# vendor_boot partition (96 MiB)
PAGESIZE=4096
OS_VERSION=17.0.0
OS_PATCH=2026-09

MKBOOTIMG=${MKBOOTIMG:-/usr/bin/mkbootimg}
AVBTOOL=${AVBTOOL:-/usr/bin/avbtool}
UNPACK=${UNPACK:-/usr/bin/unpack_bootimg}
[ "$(readlink -f "$MKBOOTIMG")" = "$(readlink -f "$0")" ] && MKBOOTIMG=/usr/bin/mkbootimg

die() { echo "mkvendorbootimg: $*" >&2; exit 1; }

[ -f "$KEY" ] || die "AVB key not found: $KEY"
mkdir -p "$OUT"
work=$(mktemp -d "$OUT/.build.XXXXXX"); trap 'rm -rf "$work"' EXIT

# ---- vendor ramdisk -------------------------------------------------------
if [ -z "$RAMDISK" ]; then
	[ -d "$INITRAMFS" ] || die "initramfs staging dir not found: $INITRAMFS"
	RAMDISK=$work/initramfs.cpio.gz
	echo "ramdisk: packing $INITRAMFS ($(find "$INITRAMFS" -name '*.ko' | wc -l) modules)"
	( cd "$INITRAMFS" && find . -print0 | cpio --null -o --format=newc --owner=0:0 --reproducible --quiet | gzip -n -9 ) > "$RAMDISK"
else
	[ -f "$RAMDISK" ] || die "ramdisk not found: $RAMDISK"
	echo "ramdisk: using prebuilt $RAMDISK"
fi
[ "$(stat -c %s "$RAMDISK")" -lt $((SIZE - 400000)) ] || die "ramdisk too large for partition"

# ---- board DTB ------------------------------------------------------------
if [ ! -f "$DTB" ]; then
	[ -f "$DTS" ] || die "neither $DTB nor $DTS exists"
	echo "dtb    : compiling $DTS"
	dtc -I dts -O dtb -o "$DTB" "$DTS"
fi

# ---- vendor bootconfig (merged into the kernel command line) --------------
if [ ! -f "$BOOTCONFIG" ]; then
	BOOTCONFIG=$work/bootconfig.extra
	cat > "$BOOTCONFIG" <<'EOF'
# Extra kernel command line parameters merged by the bootloader.
# Keep the console alive across system suspend so a failed resume is captured
# in pstore, and let the PM core log each suspend step.
no_console_suspend
pm_debug_messages
EOF
	echo "bootcfg: using built-in default"
fi

echo "dtb    : $DTB ($(stat -c %s "$DTB") bytes, md5 $(md5sum "$DTB" | cut -d' ' -f1))"

# ---- pack + sign ----------------------------------------------------------
img=$OUT/vendor_boot.img
"$MKBOOTIMG" --header_version 4 --pagesize $PAGESIZE \
	--os_version "$OS_VERSION" --os_patch_level "$OS_PATCH" \
	--vendor_ramdisk "$RAMDISK" --dtb "$DTB" \
	--vendor_bootconfig "$BOOTCONFIG" \
	--vendor_boot "$img"

[ "$(stat -c %s "$img")" -le "$SIZE" ] || die "vendor_boot.img larger than partition"
"$AVBTOOL" add_hash_footer --image "$img" --partition_name vendor_boot \
	--partition_size "$SIZE" --algorithm SHA256_RSA4096 --key "$KEY" \
	--prop "com.android.build.boot.os_version:$OS_VERSION" \
	--prop "com.android.build.boot.security_patch:$OS_PATCH" >/dev/null
"$AVBTOOL" verify_image --image "$img" --key "$KEY" >/dev/null

echo "--- self check ---"
( cd "$work" && "$UNPACK" --boot_img "$img" 2>/dev/null ) | grep -E "pagesize|vendor_ramdisk|dtb|bootconfig" | head -4
echo "$img: $(stat -c %s "$img") bytes  md5 $(md5sum "$img" | cut -d' ' -f1)"
echo "flash: dd if=$img of=/dev/disk/by-partlabel/vendor_boot_b bs=4M conv=fsync"
