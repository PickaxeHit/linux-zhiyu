#!/bin/bash
# mkbootimg — build and AVB-sign boot.img for Lenovo TB378FC ("zhiyu", SM8750).
#
#   boot.img = kernel Image + fixed command line
#   (the /init and every .ko used at boot live in the vendor ramdisk, so boot.img
#    carries no ramdisk)
#
# usage: ./mkbootimg [outdir]
# env:   KERNEL, CMDLINE, KEY, SIZE, OUT
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
OUT=${OUT:-${1:-$ROOT/out}}
KERNEL=${KERNEL:-$ROOT/kernel-source/arch/arm64/boot/Image}
KEY=${KEY:-$ROOT/avb-test-key.pem}
SIZE=${SIZE:-100663296}		# boot partition (96 MiB)
PAGESIZE=4096
OS_VERSION=17.0.0
OS_PATCH=2026-09

# Boot command line.  Keep in sync with the flashed image: console stays alive
# across suspend so a failed resume is captured in pstore, and genpd/clk are
# not allowed to shut down unused blocks (io mappings we poke by hand).
CMDLINE=${CMDLINE:-"qcom_ice.use_wrapped_keys=1 rdinit=/init console=tty0 loglevel=7 ignore_loglevel log_buf_len=4M keep_bootcon fbcon=nodefer panic=15 clk_ignore_unused pd_ignore_unused androidboot.slot_suffix=_b androidboot.bootdevice=1d84000.ufshc msm_drm.dsi_display0=qcom,mdss_dsi_zhiyu_nt36526_csot_dsc_vid: hqsysfs.pcba_stage=PVT ufsffu.boot_mode=normal rootwait ro init=/sbin/init silent_boot.mode=nonsilent no_console_suspend pm_debug_messages mem_sleep_default=s2idle"}

MKBOOTIMG=${MKBOOTIMG:-/usr/bin/mkbootimg}
AVBTOOL=${AVBTOOL:-/usr/bin/avbtool}
UNPACK=${UNPACK:-/usr/bin/unpack_bootimg}

# The script is named like the tool it wraps: never exec itself.
[ "$(readlink -f "$MKBOOTIMG")" = "$(readlink -f "$0")" ] && MKBOOTIMG=/usr/bin/mkbootimg

die() { echo "mkbootimg: $*" >&2; exit 1; }

# Which LSM set the image activates.  All of them are built into the kernel;
# the command line only picks the active ones, so one kernel still serves every
# variant and testing SELinux or AppArmor does not need a rebuild.  "none"
# leaves lsm= alone and uses CONFIG_LSM (landlock,yama,integrity).
LSM_VARIANT=${LSM_VARIANT:-none}
case $LSM_VARIANT in
none)		LSM_ARG="" ;;
selinux|se)	LSM_VARIANT=selinux; LSM_ARG="lsm=landlock,yama,selinux" ;;
apparmor|aa)	LSM_VARIANT=apparmor; LSM_ARG="lsm=landlock,yama,apparmor" ;;
*)		die "unknown LSM_VARIANT: $LSM_VARIANT (none|selinux|apparmor)" ;;
esac
[ -n "$LSM_ARG" ] && CMDLINE="$CMDLINE $LSM_ARG"

[ -f "$KERNEL" ] || die "kernel image not found: $KERNEL (build it: make -C kernel-source ARCH=arm64 LLVM=1 Image)"
[ -f "$KEY" ]    || die "AVB key not found: $KEY"
[ "$SIZE" -ge "$(stat -c %s "$KERNEL")" ] || die "kernel larger than partition"
mkdir -p "$OUT"
work=$(mktemp -d "$OUT/.build.XXXXXX"); trap 'rm -rf "$work"' EXIT

# avbtool derives the file it re-opens for verification from the hash
# descriptor's partition name (<dir>/boot.img), so build under that name and
# only rename the finished image.
img=$work/boot.img
echo "kernel : $KERNEL ($(stat -c %s "$KERNEL") bytes, md5 $(md5sum "$KERNEL" | cut -d' ' -f1))"

"$MKBOOTIMG" --header_version 4 --pagesize $PAGESIZE \
	--os_version "$OS_VERSION" --os_patch_level "$OS_PATCH" \
	--kernel "$KERNEL" --cmdline "$CMDLINE" \
	--output "$img"

"$AVBTOOL" add_hash_footer --image "$img" --partition_name boot \
	--partition_size "$SIZE" --algorithm SHA256_RSA4096 --key "$KEY" \
	--prop "com.android.build.boot.os_version:$OS_VERSION" \
	--prop "com.android.build.boot.security_patch:$OS_PATCH" >/dev/null
"$AVBTOOL" verify_image --image "$img" --key "$KEY" >/dev/null

if [ -x "$UNPACK" ]; then
	echo "--- self check ---"
	# unpack_bootimg is optional (it comes with some, but not all, mkbootimg
	# packages), and the pipeline must not fail the build when it prints
	# nothing: sed is used instead of head so the consumer never closes the
	# pipe early under "set -o pipefail".
	( cd "$work" && "$UNPACK" --boot_img "$img" 2>/dev/null ) |
		grep -E "kernel_size|ramdisk size|command line" |
		sed -n '1,3p' || true
fi
final=$OUT/boot-$LSM_VARIANT.img
cp -f "$img" "$final"
# Keep the historical name for the default variant so flashing instructions
# that only mention boot.img keep working.
[ "$LSM_VARIANT" = none ] && cp -f "$img" "$OUT/boot.img"

echo "$final: $(stat -c %s "$final") bytes  md5 $(md5sum "$final" | cut -d' ' -f1)"
echo "flash: dd if=$final of=/dev/disk/by-partlabel/boot_b bs=4M conv=fsync"
